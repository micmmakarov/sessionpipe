{
  "$id": "https://sessionpipe.org/schema/v1/batch-response.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "accepted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "duplicates": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "reason"
        ]
      }
    },
    "max_tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    }
  },
  "required": [
    "accepted",
    "duplicates",
    "rejected",
    "max_tier"
  ]
}
