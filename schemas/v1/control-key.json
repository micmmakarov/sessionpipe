{
  "$id": "https://sessionpipe.org/schema/v1/control-key.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 1400,
      "pattern": "^[A-Za-z0-9_-]*$"
    },
    "alg": {
      "anyOf": [
        {
          "type": "number",
          "const": -7
        },
        {
          "type": "number",
          "const": -257
        }
      ]
    },
    "spki": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]*$"
    }
  },
  "required": [
    "id",
    "alg",
    "spki"
  ]
}
