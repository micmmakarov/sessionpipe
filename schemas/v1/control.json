{
  "$id": "https://sessionpipe.org/schema/v1/control.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "t": {
      "type": "string",
      "const": "sessionpipe.control"
    },
    "machine": {
      "type": "string",
      "pattern": "^m_[A-Za-z0-9_-]{16,40}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "prompt",
        "permission.answer",
        "cancel",
        "start"
      ]
    },
    "session": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}:[A-Za-z0-9._-]{1,128}$"
    },
    "text": {
      "type": "string",
      "maxLength": 12000
    },
    "for": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "allow",
        "deny"
      ]
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    },
    "cwd": {
      "type": "string",
      "maxLength": 400
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,64}$"
    },
    "iat": {
      "type": "number"
    }
  },
  "required": [
    "v",
    "t",
    "machine",
    "kind",
    "session",
    "nonce",
    "iat"
  ]
}
