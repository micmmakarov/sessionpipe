{
  "name": "control-double-ack",
  "spec": "CONTROL.md \u00a77",
  "capability": "control",
  "steps": [
    {
      "enqueue": {
        "machine": "{machine}",
        "sign": {
          "session": "claude-code:{uuid}",
          "kind": "cancel"
        },
        "expires_in_s": 60
      }
    },
    {
      "poll": {
        "machine": "{machine}",
        "wait": 1
      },
      "expect": {
        "status": 200
      }
    },
    {
      "ack": {
        "outcome": "unsupported"
      },
      "expect": {
        "status": 202
      }
    },
    {
      "ack": {
        "outcome": "unsupported"
      },
      "expect": {
        "status": 202
      }
    },
    {
      "poll": {
        "machine": "{machine}",
        "wait": 1
      },
      "expect": {
        "status": 204
      }
    }
  ]
}
