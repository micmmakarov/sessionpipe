{
  "name": "control",
  "spec": "CONTROL.md \u00a72, \u00a77",
  "capability": "control",
  "note": "The runner pairs a test passkey with the receiver's test machine ({machine}), signs each command fresh, and polls with that machine's poll key.",
  "steps": [
    {
      "enqueue": {
        "machine": "{machine}",
        "sign": {
          "session": "claude-code:{uuid}",
          "kind": "prompt",
          "text": "conformance ping"
        },
        "expires_in_s": 60
      }
    },
    {
      "poll": {
        "machine": "{machine}",
        "wait": 1
      },
      "expect": {
        "status": 200,
        "body": {
          "messages": [
            {
              "id": "*",
              "cmd": "*",
              "csig": "*",
              "grant": "*"
            }
          ]
        }
      }
    },
    {
      "ack": {
        "outcome": "delivered",
        "mode": "waiter"
      },
      "expect": {
        "status": 202
      }
    },
    {
      "poll": {
        "machine": "{machine}",
        "wait": 1
      },
      "expect": {
        "status": 204
      }
    }
  ]
}
