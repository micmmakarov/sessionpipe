{
  "name": "control-expired",
  "spec": "CONTROL.md \u00a72, \u00a77",
  "capability": "control",
  "steps": [
    {
      "enqueue": {
        "machine": "{machine}",
        "sign": {
          "session": "claude-code:{uuid}",
          "kind": "permission.answer",
          "for": "att-1",
          "decision": "allow"
        },
        "expires_in_s": 1
      }
    },
    {
      "wait_s": 2
    },
    {
      "poll": {
        "machine": "{machine}",
        "wait": 1
      },
      "expect": {
        "status": 204
      }
    }
  ]
}
